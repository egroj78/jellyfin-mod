+/**
+ * Holds the subtitle offset (a.k.a. subtitle delay) for the item that is currently playing.
+ *
+ * A positive value shows the subtitles later, a negative value shows them earlier.
+ * The value is kept while the same item is playing (e.g. when switching quality or audio track)
+ * and reset to 0 when a different item starts.
+ */
+object SubtitleOffset {
+	const val SMALL_STEP_MS = 100L
+	const val LARGE_STEP_MS = 1_000L
+	private const val MAX_OFFSET_MS = 600_000L
+
+	@Volatile
+	var offsetMs: Long = 0
+		set(value) {
+			field = value.coerceIn(-MAX_OFFSET_MS, MAX_OFFSET_MS)
+		}
+
+	private var currentItemId: UUID? = null
+
+	fun onItemStarted(itemId: UUID?) {
+		if (itemId != currentItemId) {
+			currentItemId = itemId
+			offsetMs = 0
+		}
+	}
+
+	fun format(offsetMs: Long = this.offsetMs): String {
+		val sign = when {
+			offsetMs > 0 -> "+"
+			offsetMs < 0 -> "−"
+			else -> ""
+		}
+		return String.format(Locale.US, "%s%.1f s", sign, kotlin.math.abs(offsetMs) / 1000.0)
+	}
+}
+
+/**
+ * Wraps a [TextRenderer] and feeds it a shifted playback position so subtitles are displayed
+ * [SubtitleOffset.offsetMs] later (or earlier when negative) without touching the media itself.
+ * Changes to the offset apply immediately, no re-buffering needed.
+ */
+class SubtitleOffsetRenderer(renderer: Renderer) : ForwardingRenderer(renderer) {
+	private var timeline: Timeline = Timeline.EMPTY
+	private val period = Timeline.Period()
+	private var streamOffsetUs = 0L
+	private var periodUid: Any? = null
+	private var lastPositionUs = C.TIME_UNSET
+
+	private fun shiftUs(): Long = SubtitleOffset.offsetMs * 1_000L
+
+	override fun enable(
+		configuration: RendererConfiguration,
+		formats: Array<out Format>,
+		stream: SampleStream,
+		positionUs: Long,
+		joining: Boolean,
+		mayRenderStartOfStream: Boolean,
+		startPositionUs: Long,
+		offsetUs: Long,
+		mediaPeriodId: MediaSource.MediaPeriodId,
+	) {
+		streamOffsetUs = offsetUs
+		periodUid = mediaPeriodId.periodUid
+		lastPositionUs = C.TIME_UNSET
+		super.enable(configuration, formats, stream, positionUs, joining, mayRenderStartOfStream, startPositionUs, offsetUs, mediaPeriodId)
+	}
+
+	override fun replaceStream(
+		formats: Array<out Format>,
+		stream: SampleStream,
+		startPositionUs: Long,
+		offsetUs: Long,
+		mediaPeriodId: MediaSource.MediaPeriodId,
+	) {
+		streamOffsetUs = offsetUs
+		periodUid = mediaPeriodId.periodUid
+		super.replaceStream(formats, stream, startPositionUs, offsetUs, mediaPeriodId)
+	}
+
+	override fun setTimeline(timeline: Timeline) {
+		this.timeline = timeline
+		super.setTimeline(timeline)
+	}
+
+	override fun render(positionUs: Long, elapsedRealtimeUs: Long) {
+		lastPositionUs = positionUs
+		super.render(positionUs - shiftUs(), elapsedRealtimeUs)
+	}
+
+	override fun getDurationToProgressUs(positionUs: Long, elapsedRealtimeUs: Long): Long =
+		super.getDurationToProgressUs(positionUs - shiftUs(), elapsedRealtimeUs)
+
+	override fun isEnded(): Boolean {
+		if (super.isEnded()) return true
+		// When subtitles are delayed the wrapped renderer never "reaches" the end of the stream by
+		// itself, which would keep the player from ending. Report ended once the real playback
+		// position passed the end of the media.
+		if (shiftUs() <= 0 || lastPositionUs == C.TIME_UNSET) return false
+		val uid = periodUid ?: return false
+		val periodIndex = timeline.getIndexOfPeriod(uid)
+		if (periodIndex == C.INDEX_UNSET) return false
+		val durationUs = timeline.getPeriod(periodIndex, period).durationUs
+		if (durationUs == C.TIME_UNSET) return false
+		return lastPositionUs - streamOffsetUs >= durationUs
+	}
+}
+
+/**
+ * [RenderersFactory] that wraps all [TextRenderer] instances created by [delegate] in a
+ * [SubtitleOffsetRenderer].
+ */
+class SubtitleOffsetRenderersFactory(
+	private val delegate: RenderersFactory,
+) : RenderersFactory {
+	override fun createRenderers(
+		eventHandler: Handler,
+		videoRendererEventListener: VideoRendererEventListener,
+		audioRendererEventListener: AudioRendererEventListener,
+		textRendererOutput: TextOutput,
+		metadataRendererOutput: MetadataOutput,
+	): Array<Renderer> = delegate.createRenderers(
+		eventHandler,
+		videoRendererEventListener,
+		audioRendererEventListener,
+		textRendererOutput,
+		metadataRendererOutput,
+	).map { renderer ->
+		if (renderer is TextRenderer) SubtitleOffsetRenderer(renderer) else renderer
+	}.toTypedArray()
+}
