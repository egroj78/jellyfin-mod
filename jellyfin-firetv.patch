+import androidx.annotation.StringRes
+import org.jellyfin.androidtv.R
+import org.jellyfin.androidtv.ui.playback.PlaybackController
+import org.jellyfin.androidtv.ui.playback.AudioOffset
+import org.jellyfin.androidtv.ui.playback.ItemOffset
+import org.jellyfin.androidtv.ui.playback.SubtitleOffset
+import org.jellyfin.androidtv.ui.playback.overlay.CustomPlaybackTransportControlGlue
+import org.jellyfin.androidtv.ui.playback.overlay.VideoPlayerAdapter
+
+/**
+ * Player action that opens a small panel to shift the subtitles in time
+ * ("subtitle offset" / "subtitle delay").
+ */
+class SubtitleOffsetAction(
+	context: Context,
+	customPlaybackTransportControlGlue: CustomPlaybackTransportControlGlue,
+) : OffsetAction(
+	context,
+	customPlaybackTransportControlGlue,
+	iconRes = R.drawable.ic_subtitle_offset,
+	titleRes = R.string.lbl_subtitle_offset,
+	hintRes = R.string.lbl_subtitle_offset_hint,
+	offset = SubtitleOffset,
+)
+
+/**
+ * Player action that opens a small panel to shift the audio in time
+ * ("audio offset" / "audio delay" / lip sync).
+ */
+class AudioOffsetAction(
+	context: Context,
+	customPlaybackTransportControlGlue: CustomPlaybackTransportControlGlue,
+) : OffsetAction(
+	context,
+	customPlaybackTransportControlGlue,
+	iconRes = R.drawable.ic_audio_offset,
+	titleRes = R.string.lbl_audio_offset,
+	hintRes = R.string.lbl_audio_offset_hint,
+	offset = AudioOffset,
+)
+
+/**
+ * Base action that opens a small panel to adjust an [ItemOffset]. The panel stays open while
+ * adjusting so the result can be checked live; press Back to close it.
+ */
+open class OffsetAction(
+	context: Context,
+	customPlaybackTransportControlGlue: CustomPlaybackTransportControlGlue,
+	@DrawableRes iconRes: Int,
+	@StringRes private val titleRes: Int,
+	@StringRes private val hintRes: Int,
+	private val offset: ItemOffset,
+) : CustomAction(context, customPlaybackTransportControlGlue) {
+	private var popup: PopupWindow? = null
+
+	init {
+		initializeWithIcon(iconRes)
+	}
+
+	override fun handleClickAction(
+		playbackController: PlaybackController,
+		videoPlayerAdapter: VideoPlayerAdapter,
+		context: Context,
+		view: View,
+	) {
+		dismissPopup()
+		videoPlayerAdapter.leanbackOverlayFragment.setFading(false)
+
+		val density = context.resources.displayMetrics.density
+		fun dp(value: Int) = (value * density).toInt()
+
+		val valueView = TextView(context).apply {
+			setTextColor(Color.WHITE)
+			textSize = 22f
+			typeface = Typeface.DEFAULT_BOLD
+			gravity = Gravity.CENTER
+			minWidth = dp(110)
+			text = offset.format()
+		}
+
+		fun refresh() {
+			valueView.text = offset.format()
+		}
+
+		fun button(label: String, onClick: () -> Unit) = TextView(context).apply {
+			text = label
+			textSize = 16f
+			gravity = Gravity.CENTER
+			minWidth = dp(72)
+			setPadding(dp(14), dp(10), dp(14), dp(10))
+			isFocusable = true
+			isClickable = true
+			background = buttonBackground(dp(6).toFloat())
+			setTextColor(
+				ColorStateList(
+					arrayOf(intArrayOf(android.R.attr.state_focused), intArrayOf()),
+					intArrayOf(Color.BLACK, Color.WHITE),
+				)
+			)
+			setOnClickListener {
+				onClick()
+				refresh()
+			}
+			layoutParams = LinearLayout.LayoutParams(
+				ViewGroup.LayoutParams.WRAP_CONTENT,
+				ViewGroup.LayoutParams.WRAP_CONTENT,
+			).apply { setMargins(dp(4), 0, dp(4), 0) }
+		}
+
+		fun add(deltaMs: Long) {
+			offset.offsetMs += deltaMs
+		}
+
+		val small = offset.smallStepMs
+		val large = offset.largeStepMs
+		val smallPlus = button(offset.format(small)) { add(small) }
+
+		val row = LinearLayout(context).apply {
+			orientation = LinearLayout.HORIZONTAL
+			gravity = Gravity.CENTER_VERTICAL
+			addView(button(offset.format(-large)) { add(-large) })
+			addView(button(offset.format(-small)) { add(-small) })
+			addView(valueView)
+			addView(smallPlus)
+			addView(button(offset.format(large)) { add(large) })
+			addView(button(context.getString(R.string.lbl_subtitle_offset_reset)) { offset.offsetMs = 0 })
+		}
+
+		val container = LinearLayout(context).apply {
+			orientation = LinearLayout.VERTICAL
+			gravity = Gravity.CENTER_HORIZONTAL
+			setPadding(dp(20), dp(14), dp(20), dp(14))
+			background = GradientDrawable().apply {
+				cornerRadius = dp(12).toFloat()
+				setColor(Color.argb(230, 24, 24, 24))
+			}
+
+			addView(TextView(context).apply {
+				text = context.getString(titleRes)
+				setTextColor(Color.WHITE)
+				textSize = 18f
+				setPadding(0, 0, 0, dp(10))
+			})
+			addView(row)
+			addView(TextView(context).apply {
+				text = context.getString(hintRes)
+				setTextColor(Color.argb(180, 255, 255, 255))
+				textSize = 13f
+				setPadding(0, dp(10), 0, 0)
+			})
+		}
+
+		popup = PopupWindow(
+			container,
+			ViewGroup.LayoutParams.WRAP_CONTENT,
+			ViewGroup.LayoutParams.WRAP_CONTENT,
+			true,
+		).apply {
+			setBackgroundDrawable(ColorDrawable(Color.TRANSPARENT))
+			isOutsideTouchable = true
+			setOnDismissListener {
+				videoPlayerAdapter.leanbackOverlayFragment.setFading(true)
+				popup = null
+			}
+			// Show at the top so the subtitles at the bottom stay visible while adjusting
+			showAtLocation(view.rootView, Gravity.TOP or Gravity.CENTER_HORIZONTAL, 0, dp(40))
+		}
+
+		smallPlus.post { smallPlus.requestFocus() }
+	}
+
+	private fun buttonBackground(radius: Float) = StateListDrawable().apply {
+		addState(intArrayOf(android.R.attr.state_focused), GradientDrawable().apply {
+			cornerRadius = radius
+			setColor(Color.WHITE)
+		})
+		addState(intArrayOf(), GradientDrawable().apply {
+			cornerRadius = radius
+			setColor(Color.argb(60, 255, 255, 255))
+		})
+	}
+
+	fun dismissPopup() {
+		popup?.dismiss()
+	}
+}
