+/**
+ * Player action that opens a small panel to shift the subtitles in time
+ * ("subtitle offset" / "subtitle delay"). The panel stays open while adjusting so the
+ * result can be checked live; press Back to close it.
+ */
+class SubtitleOffsetAction(
+	context: Context,
+	customPlaybackTransportControlGlue: CustomPlaybackTransportControlGlue,
+) : CustomAction(context, customPlaybackTransportControlGlue) {
+	private var popup: PopupWindow? = null
+
+	init {
+		initializeWithIcon(R.drawable.ic_subtitle_offset)
+	}
+
+	override fun handleClickAction(
+		playbackController: PlaybackController,
+		videoPlayerAdapter: VideoPlayerAdapter,
+		context: Context,
+		view: View,
+	) {
+		dismissPopup()
+		videoPlayerAdapter.leanbackOverlayFragment.setFading(false)
+
+		val density = context.resources.displayMetrics.density
+		fun dp(value: Int) = (value * density).toInt()
+
+		val valueView = TextView(context).apply {
+			setTextColor(Color.WHITE)
+			textSize = 22f
+			typeface = Typeface.DEFAULT_BOLD
+			gravity = Gravity.CENTER
+			minWidth = dp(110)
+			text = SubtitleOffset.format()
+		}
+
+		fun refresh() {
+			valueView.text = SubtitleOffset.format()
+		}
+
+		fun button(label: String, onClick: () -> Unit) = TextView(context).apply {
+			text = label
+			textSize = 16f
+			gravity = Gravity.CENTER
+			minWidth = dp(72)
+			setPadding(dp(14), dp(10), dp(14), dp(10))
+			isFocusable = true
+			isClickable = true
+			background = buttonBackground(dp(6).toFloat())
+			setTextColor(
+				ColorStateList(
+					arrayOf(intArrayOf(android.R.attr.state_focused), intArrayOf()),
+					intArrayOf(Color.BLACK, Color.WHITE),
+				)
+			)
+			setOnClickListener {
+				onClick()
+				refresh()
+			}
+			layoutParams = LinearLayout.LayoutParams(
+				ViewGroup.LayoutParams.WRAP_CONTENT,
+				ViewGroup.LayoutParams.WRAP_CONTENT,
+			).apply { setMargins(dp(4), 0, dp(4), 0) }
+		}
+
+		fun add(deltaMs: Long) {
+			SubtitleOffset.offsetMs += deltaMs
+		}
+
+		val smallPlus = button("+0.1 s") { add(SubtitleOffset.SMALL_STEP_MS) }
+
+		val row = LinearLayout(context).apply {
+			orientation = LinearLayout.HORIZONTAL
+			gravity = Gravity.CENTER_VERTICAL
+			addView(button("−1 s") { add(-SubtitleOffset.LARGE_STEP_MS) })
+			addView(button("−0.1 s") { add(-SubtitleOffset.SMALL_STEP_MS) })
+			addView(valueView)
+			addView(smallPlus)
+			addView(button("+1 s") { add(SubtitleOffset.LARGE_STEP_MS) })
+			addView(button(context.getString(R.string.lbl_subtitle_offset_reset)) { SubtitleOffset.offsetMs = 0 })
+		}
+
+		val container = LinearLayout(context).apply {
+			orientation = LinearLayout.VERTICAL
+			gravity = Gravity.CENTER_HORIZONTAL
+			setPadding(dp(20), dp(14), dp(20), dp(14))
+			background = GradientDrawable().apply {
+				cornerRadius = dp(12).toFloat()
+				setColor(Color.argb(230, 24, 24, 24))
+			}
+
+			addView(TextView(context).apply {
+				text = context.getString(R.string.lbl_subtitle_offset)
+				setTextColor(Color.WHITE)
+				textSize = 18f
+				setPadding(0, 0, 0, dp(10))
+			})
+			addView(row)
+			addView(TextView(context).apply {
+				text = context.getString(R.string.lbl_subtitle_offset_hint)
+				setTextColor(Color.argb(180, 255, 255, 255))
+				textSize = 13f
+				setPadding(0, dp(10), 0, 0)
+			})
+		}
+
+		popup = PopupWindow(
+			container,
+			ViewGroup.LayoutParams.WRAP_CONTENT,
+			ViewGroup.LayoutParams.WRAP_CONTENT,
+			true,
+		).apply {
+			setBackgroundDrawable(ColorDrawable(Color.TRANSPARENT))
+			isOutsideTouchable = true
+			setOnDismissListener {
+				videoPlayerAdapter.leanbackOverlayFragment.setFading(true)
+				popup = null
+			}
+			// Show at the top so the subtitles at the bottom stay visible while adjusting
+			showAtLocation(view.rootView, Gravity.TOP or Gravity.CENTER_HORIZONTAL, 0, dp(40))
+		}
+
+		smallPlus.post { smallPlus.requestFocus() }
+	}
+
+	private fun buttonBackground(radius: Float) = StateListDrawable().apply {
+		addState(intArrayOf(android.R.attr.state_focused), GradientDrawable().apply {
+			cornerRadius = radius
+			setColor(Color.WHITE)
+		})
+		addState(intArrayOf(), GradientDrawable().apply {
+			cornerRadius = radius
+			setColor(Color.argb(60, 255, 255, 255))
+		})
+	}
+
+	fun dismissPopup() {
+		popup?.dismiss()
+	}
+}
