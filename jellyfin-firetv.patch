@@ -0,0 +1,181 @@
+package org.jellyfin.androidtv.ui.playback.overlay.action
+
+import android.app.AlertDialog
+import android.content.Context
+import android.view.View
+import androidx.annotation.OptIn
+import androidx.media3.common.util.UnstableApi
+import org.jellyfin.androidtv.R
+import org.jellyfin.androidtv.ui.playback.PlaybackController
+import org.jellyfin.androidtv.ui.playback.SubtitleOffset
+import org.jellyfin.androidtv.ui.playback.overlay.CustomPlaybackTransportControlGlue
+import org.jellyfin.androidtv.ui.playback.overlay.VideoPlayerAdapter
+import org.jellyfin.sdk.model.api.BaseItemKind
+import org.jellyfin.sdk.model.api.MediaStream
+import org.jellyfin.sdk.model.api.MediaStreamType
+import org.jellyfin.sdk.model.api.PlayMethod
+import org.jellyfin.sdk.model.api.SubtitleDeliveryMethod
+import org.jellyfin.sdk.model.api.VideoRangeType
+import java.util.Locale
+
+/**
+ * Player action that shows technical information about what is currently playing:
+ * play method, container, video/audio/subtitle streams and what the player is decoding.
+ */
+class MediaInfoAction(
+	context: Context,
+	customPlaybackTransportControlGlue: CustomPlaybackTransportControlGlue,
+) : CustomAction(context, customPlaybackTransportControlGlue) {
+	private var dialog: AlertDialog? = null
+
+	init {
+		initializeWithIcon(R.drawable.ic_media_info)
+	}
+
+	override fun handleClickAction(
+		playbackController: PlaybackController,
+		videoPlayerAdapter: VideoPlayerAdapter,
+		context: Context,
+		view: View,
+	) {
+		dismissPopup()
+		videoPlayerAdapter.leanbackOverlayFragment.setFading(false)
+
+		dialog = AlertDialog.Builder(context)
+			.setTitle(R.string.lbl_media_info)
+			.setMessage(buildInfo(playbackController))
+			.setPositiveButton(R.string.lbl_media_info_close, null)
+			.setOnDismissListener {
+				videoPlayerAdapter.leanbackOverlayFragment.setFading(true)
+				dialog = null
+			}
+			.show()
+	}
+
+	fun dismissPopup() {
+		dialog?.dismiss()
+	}
+
+	private fun buildInfo(controller: PlaybackController): String = buildString {
+		val item = controller.currentlyPlayingItem
+		val streamInfo = controller.currentStreamInfo
+		val mediaSource = controller.currentMediaSource
+		val streams = mediaSource?.mediaStreams.orEmpty()
+
+		// Title
+		if (item != null) {
+			if (item.type == BaseItemKind.EPISODE && item.seriesName != null) {
+				val season = item.parentIndexNumber
+				val episode = item.indexNumber
+				append(item.seriesName)
+				if (season != null && episode != null) append(String.format(Locale.US, " · S%02dE%02d", season, episode))
+				appendLine()
+			}
+			appendLine(item.name.orEmpty())
+			appendLine()
+		}
+
+		// General
+		val playMethod = when (streamInfo?.playMethod) {
+			PlayMethod.DIRECT_PLAY -> "Direct Play"
+			PlayMethod.DIRECT_STREAM -> "Direct Stream"
+			PlayMethod.TRANSCODE -> "Transcode"
+			null -> "?"
+		}
+		appendLine("▸ Reproducción: $playMethod")
+		mediaSource?.container?.let { appendLine("▸ Contenedor: ${it.uppercase()}") }
+		if (streamInfo?.playMethod == PlayMethod.TRANSCODE) {
+			mediaSource?.transcodingContainer?.let { appendLine("▸ Contenedor transcodificado: ${it.uppercase()}") }
+		}
+		mediaSource?.size?.takeIf { it > 0 }?.let { appendLine("▸ Tamaño: ${formatSize(it)}") }
+		mediaSource?.bitrate?.takeIf { it > 0 }?.let { appendLine("▸ Bitrate total: ${formatBitrate(it)}") }
+
+		// Video
+		streams.filter { it.type == MediaStreamType.VIDEO }.forEach { video ->
+			appendLine()
+			appendLine("VÍDEO")
+			appendLine("▸ ${listOfNotNull(video.codec?.uppercase(), video.profile).joinToString(" ")}")
+			if (video.width != null && video.height != null) appendLine("▸ Resolución: ${video.width}×${video.height}")
+			(video.realFrameRate ?: video.averageFrameRate)?.let { appendLine(String.format(Locale.US, "▸ FPS: %.3f", it)) }
+			video.bitRate?.takeIf { it > 0 }?.let { appendLine("▸ Bitrate: ${formatBitrate(it)}") }
+			video.bitDepth?.let { appendLine("▸ Profundidad: $it bit") }
+			if (video.videoRangeType != VideoRangeType.UNKNOWN) appendLine("▸ Rango: ${video.videoRangeType.serialName}")
+		}
+
+		// Audio
+		val audioIndex = controller.audioStreamIndex
+		streams.firstOrNull { it.type == MediaStreamType.AUDIO && it.index == audioIndex }?.let { audio ->
+			appendLine()
+			appendLine("AUDIO")
+			audio.displayTitle?.let { appendLine("▸ $it") }
+			appendLine("▸ ${listOfNotNull(audio.codec?.uppercase(), audio.profile, audio.channelLayout ?: audio.channels?.let { "$it ch" }).joinToString(" · ")}")
+			audio.bitRate?.takeIf { it > 0 }?.let { appendLine("▸ Bitrate: ${formatBitrate(it)}") }
+			audio.sampleRate?.let { appendLine("▸ Frecuencia: $it Hz") }
+		}
+
+		// Subtitles
+		appendLine()
+		appendLine("SUBTÍTULOS")
+		val subtitleIndex = controller.subtitleStreamIndex
+		val subtitle = streams.firstOrNull { it.type == MediaStreamType.SUBTITLE && it.index == subtitleIndex }
+		if (subtitle == null) {
+			appendLine("▸ Desactivados")
+		} else {
+			subtitle.displayTitle?.let { appendLine("▸ $it") }
+			appendLine("▸ ${listOfNotNull(subtitle.codec?.uppercase(), deliveryLabel(subtitle)).joinToString(" · ")}")
+			appendLine("▸ Desfase: ${SubtitleOffset.format()}")
+		}
+
+		// What the player is actually decoding
+		appendPlayerInfo(controller)
+	}
+
+	@OptIn(UnstableApi::class)
+	private fun StringBuilder.appendPlayerInfo(controller: PlaybackController) {
+		val player = controller.videoManager?.mExoPlayer ?: return
+		val videoFormat = player.videoFormat
+		val audioFormat = player.audioFormat
+		if (videoFormat == null && audioFormat == null) return
+
+		appendLine()
+		appendLine("REPRODUCTOR")
+		videoFormat?.let { format ->
+			val parts = listOfNotNull(
+				format.codecs ?: format.sampleMimeType,
+				if (format.width > 0 && format.height > 0) "${format.width}×${format.height}" else null,
+				if (format.frameRate > 0) String.format(Locale.US, "%.3f fps", format.frameRate) else null,
+			)
+			appendLine("▸ Vídeo: ${parts.joinToString(" · ")}")
+		}
+		audioFormat?.let { format ->
+			val parts = listOfNotNull(
+				format.codecs ?: format.sampleMimeType,
+				if (format.channelCount > 0) "${format.channelCount} ch" else null,
+				if (format.sampleRate > 0) "${format.sampleRate} Hz" else null,
+			)
+			appendLine("▸ Audio: ${parts.joinToString(" · ")}")
+		}
+		val counters = player.videoDecoderCounters
+		if (counters != null) {
+			counters.ensureUpdated()
+			appendLine("▸ Fotogramas perdidos: ${counters.droppedBufferCount}")
+		}
+	}
+
+	private fun deliveryLabel(stream: MediaStream): String? = when (stream.deliveryMethod) {
+		SubtitleDeliveryMethod.EXTERNAL -> "Externo"
+		SubtitleDeliveryMethod.EMBED -> "Incrustado"
+		SubtitleDeliveryMethod.ENCODE -> "Quemado (burn-in)"
+		SubtitleDeliveryMethod.HLS -> "HLS"
+		SubtitleDeliveryMethod.DROP -> null
+		null -> if (stream.isExternal) "Externo" else null
+	}
+
+	private fun formatBitrate(bps: Int): String =
+		if (bps >= 1_000_000) String.format(Locale.US, "%.1f Mbps", bps / 1_000_000.0)
+		else String.format(Locale.US, "%d kbps", bps / 1_000)
+
+	private fun formatSize(bytes: Long): String =
+		if (bytes >= 1_073_741_824L) String.format(Locale.US, "%.2f GB", bytes / 1_073_741_824.0)
+		else String.format(Locale.US, "%.0f MB", bytes / 1_048_576.0)
+}
